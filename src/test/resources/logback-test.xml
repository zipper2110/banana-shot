<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests log only to the console. They must not write to the log folder of the user. -->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.litvin" level="${APP_LOG_LEVEL:-INFO}" />
    <logger name="com.formdev.flatlaf" level="WARN" />

    <root level="WARN">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
